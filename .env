# Application related
APP_NAME="Agentic AI Application"
APP_DESCRIPTION="This example shown very basic examples using Agentic AI"


# OpenAI related
OPENAI_BASE_URL="http://localhost:11434/v1"
OPENAI_API_KEY="ollama"
OPENAI_AGENTS_DISABLE_TRACING=true

OPENAI_DEFAULT_MODEL="openai/gpt-oss-20b"

# Groq related
GROQ_API_KEY="your_groq_key"
GROQ_BASE_URL="https://api.groq.com/openai/v1"

# Chroma DB related
CHROMA_DB_NAME=".chroma/weather_store"
CHROMA_DB_COLLECTION="weather_n_play"
